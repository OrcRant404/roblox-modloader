# Pinned Studio engine bindings are independent of RML's optional script VM.
set(RML_NATIVE_ENGINE_MANIFEST "${ROBLOX_MODLOADER_SOURCE_DIR}/native_api/engine-bindings.arm64.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${RML_NATIVE_ENGINE_MANIFEST}")
file(READ "${RML_NATIVE_ENGINE_MANIFEST}" RML_NATIVE_ENGINE_JSON)
string(JSON RML_NATIVE_ENGINE_HASH GET "${RML_NATIVE_ENGINE_JSON}" code_sha256)
string(JSON RML_NATIVE_ENGINE_OFFSET GET "${RML_NATIVE_ENGINE_JSON}" code_section offset)
string(JSON RML_NATIVE_ENGINE_SIZE GET "${RML_NATIVE_ENGINE_JSON}" code_section size)
string(JSON RML_NATIVE_ENGINE_COUNT LENGTH "${RML_NATIVE_ENGINE_JSON}" bindings)
math(EXPR RML_NATIVE_ENGINE_LAST "${RML_NATIVE_ENGINE_COUNT} - 1")
set(RML_NATIVE_ENGINE_HEADER "#pragma once\n#include <array>\n#include <cstddef>\n#include <cstdint>\n#include <string_view>\nstruct EngineBinding { const char* name; std::uintptr_t address; std::array<unsigned char, 32> bytes; };\nconstexpr const char* kVerifiedEngineCodeSha256 = \"${RML_NATIVE_ENGINE_HASH}\";\nconstexpr std::size_t kEngineCodeOffset = ${RML_NATIVE_ENGINE_OFFSET};\nconstexpr std::size_t kEngineCodeSize = ${RML_NATIVE_ENGINE_SIZE};\nconstexpr auto kEngineBindings = std::to_array<EngineBinding>({\n")
foreach (RML_NATIVE_ENGINE_INDEX RANGE ${RML_NATIVE_ENGINE_LAST})
    string(JSON RML_NATIVE_ENGINE_NAME GET "${RML_NATIVE_ENGINE_JSON}" bindings ${RML_NATIVE_ENGINE_INDEX} name)
    string(JSON RML_NATIVE_ENGINE_ADDRESS GET "${RML_NATIVE_ENGINE_JSON}" bindings ${RML_NATIVE_ENGINE_INDEX} address)
    string(JSON RML_NATIVE_ENGINE_BYTES GET "${RML_NATIVE_ENGINE_JSON}" bindings ${RML_NATIVE_ENGINE_INDEX} first_32_bytes)
    string(REPLACE " " ";" RML_NATIVE_ENGINE_BYTE_LIST "${RML_NATIVE_ENGINE_BYTES}")
    list(LENGTH RML_NATIVE_ENGINE_BYTE_LIST RML_NATIVE_ENGINE_BYTE_COUNT)
    if (NOT RML_NATIVE_ENGINE_BYTE_COUNT EQUAL 32)
        message(FATAL_ERROR "Native engine binding ${RML_NATIVE_ENGINE_NAME} must contain 32 verified bytes")
    endif ()
    set(RML_NATIVE_ENGINE_HEX_BYTES "")
    foreach (RML_NATIVE_ENGINE_BYTE IN LISTS RML_NATIVE_ENGINE_BYTE_LIST)
        string(APPEND RML_NATIVE_ENGINE_HEX_BYTES "0x${RML_NATIVE_ENGINE_BYTE},")
    endforeach ()
    string(APPEND RML_NATIVE_ENGINE_HEADER "{\"${RML_NATIVE_ENGINE_NAME}\", ${RML_NATIVE_ENGINE_ADDRESS}, {${RML_NATIVE_ENGINE_HEX_BYTES}}},\n")
endforeach ()
string(APPEND RML_NATIVE_ENGINE_HEADER "});\nconstexpr std::uintptr_t engine_address(std::string_view name) { for (const auto& item : kEngineBindings) if (item.name == name) return item.address; return 0; }\n")
set(RML_NATIVE_ENGINE_INCLUDE_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated/native_api")
file(MAKE_DIRECTORY "${RML_NATIVE_ENGINE_INCLUDE_DIR}")
file(WRITE "${RML_NATIVE_ENGINE_INCLUDE_DIR}/engine_bindings.generated.hpp" "${RML_NATIVE_ENGINE_HEADER}")
